# Everything the image does not need. Chiefly this keeps a developer's local
# database, virtualenv and git history out of a shipped artefact — a .env or a
# uione.db baked into a layer is a credential leak with a version tag on it.
.git
.github
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache
tests
docs
estate
# scripts/ is mounted into the provisioner rather than baked in, so the
# estate logic a person edits is the estate logic that runs.
#scripts
*.db
*.db-journal
.env
.env.*
!.env.example
htmlcov
.coverage
