# UiOne AI configuration. Copy to .env and adjust.
# Nothing here may point at the public internet — this is an on-premise product.

UIONE_HOST=127.0.0.1
UIONE_PORT=8000
UIONE_LOG_LEVEL=INFO
UIONE_ENVIRONMENT=dev

# Model plane: any OpenAI-compatible endpoint.
#   production  -> llm_inference_engine (vLLM adapter)
#   development -> llm_inference_engine (llama.cpp/MLX adapter) or Ollama
UIONE_MODEL_PLANE_URL=http://127.0.0.1:8080/v1
UIONE_MODEL_PLANE_API_KEY=

# Task tiers — see docs/PRODUCT_STRATEGY_AND_BACKLOG.md Appendix A.
UIONE_MODEL_TIER_TRIAGE=qwen3:4b
UIONE_MODEL_TIER_WORKHORSE=qwen3:30b-a3b
UIONE_MODEL_TIER_REASONING=qwen3:30b-a3b
UIONE_MODEL_TIER_EMBEDDING=qwen3-embedding:0.6b

UIONE_DATABASE_URL=sqlite+aiosqlite:///./uione.db

# preview | approve | auto — deny-by-default autonomy ladder (gap G1)
UIONE_AUTONOMY_DEFAULT_MODE=preview
